	/// Khóa số của cặp đơn × seller, dùng để lọc fact_order_seller theo sản phẩm.
	column os_key
		dataType: int64
		isHidden
		lineageTag: 4bec29ae-d73b-4a59-bdbb-1ad849b8d16b
		summarizeBy: none
		sourceColumn: os_key

	partition fact_sales_item = m
		mode: import
		source =
				let
				    Nguon = Parquet.Document ( File.Contents ( ThuMucParquet & "fact_sales_item.parquet" ) )
				in
				    Nguon

	annotation PBI_ResultType = Table

