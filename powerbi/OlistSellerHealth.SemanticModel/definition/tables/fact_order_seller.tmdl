	partition fact_order_seller = m
		mode: import
		source =
				let
				    Nguon = Parquet.Document ( File.Contents ( ThuMucParquet & "fact_order_seller.parquet" ) )
				in
				    Nguon

	annotation PBI_ResultType = Table

