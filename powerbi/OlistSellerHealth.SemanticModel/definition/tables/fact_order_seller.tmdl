/// Grain đơn × seller (core.fact_order_seller) cộng các cờ tính sẵn lúc xuất: is_valid_sale, is_due, is_late, is_review_known.
table fact_order_seller
	lineageTag: 295fa696-a2a2-5bf2-914a-40b64d98d99f

	/// Đơn mua trong lát cắt đã tới ngày hẹn trước as-of.
	measure 'Đơn đến hạn' =
			-- fact_order_seller khong noi toi dim_product: khi loc san pham, chi giu cap don x seller co dong hang hop le thuoc lat cat (qua os_key)
			IF (
			    ISCROSSFILTERED ( dim_product ),
			    CALCULATE (
			        DISTINCTCOUNT ( fact_order_seller[order_id] ),
			        fact_order_seller[is_valid_sale] = TRUE (),
			        fact_order_seller[is_due] = TRUE (),
			        TREATAS ( CALCULATETABLE ( VALUES ( fact_sales_item[os_key] ), fact_sales_item[is_valid_sale] = TRUE () ), fact_order_seller[os_key] )
			    ),
			    CALCULATE (
			        DISTINCTCOUNT ( fact_order_seller[order_id] ),
			        fact_order_seller[is_valid_sale] = TRUE (),
			        fact_order_seller[is_due] = TRUE ()
			    )
			)
		formatString: #,0
		displayFolder: Giao hàng và review
		lineageTag: d3b4be1f-6c9c-5346-802d-339bb43ff7c0

	/// Đơn đến hạn mà chưa giao hoặc giao sau ngày hẹn.
	measure 'Đơn trễ hẹn' =
			VAR denHan = [Đơn đến hạn]
			VAR tre =
			    IF (
			        ISCROSSFILTERED ( dim_product ),
			        CALCULATE (
			            DISTINCTCOUNT ( fact_order_seller[order_id] ),
			            fact_order_seller[is_valid_sale] = TRUE (),
			            fact_order_seller[is_due] = TRUE (),
			            fact_order_seller[is_late] = TRUE (),
			            TREATAS ( CALCULATETABLE ( VALUES ( fact_sales_item[os_key] ), fact_sales_item[is_valid_sale] = TRUE () ), fact_order_seller[os_key] )
			        ),
			        CALCULATE (
			            DISTINCTCOUNT ( fact_order_seller[order_id] ),
			            fact_order_seller[is_valid_sale] = TRUE (),
			            fact_order_seller[is_due] = TRUE (),
			            fact_order_seller[is_late] = TRUE ()
			        )
			    )
			RETURN
			    IF ( NOT ISBLANK ( denHan ), tre + 0 )
		formatString: #,0
		displayFolder: Giao hàng và review
		lineageTag: f4ac4583-175e-52c0-a97a-b007772b925e

	/// olap_late_rate: Số đơn trễ / số đơn đến hạn, theo tháng mua.
	measure 'Tỷ lệ trễ hẹn' = DIVIDE ( [Đơn trễ hẹn], [Đơn đến hạn] )
		formatString: 0.00%
		displayFolder: Giao hàng và review
		lineageTag: 430072d8-9757-5a20-b4ee-809f2d075139

	/// Như Tỷ lệ trễ hẹn nhưng dim_date đóng vai ngày hẹn (quan hệ không hoạt động estimated_date_key).
	measure 'Tỷ lệ trễ hẹn theo ngày hẹn' = CALCULATE ( [Tỷ lệ trễ hẹn], USERELATIONSHIP ( fact_order_seller[estimated_date_key], dim_date[date_key] ) )
		formatString: 0.00%
		displayFolder: Giao hàng và review
		lineageTag: 05cf7b83-46e8-5ac4-b9fb-c60629972f3b

	/// olap_review: Điểm review trung bình theo cặp đơn × seller.
	measure 'Review TB' =
			IF (
			    ISCROSSFILTERED ( dim_product ),
			    CALCULATE (
			        AVERAGE ( fact_order_seller[review_score] ),
			        fact_order_seller[is_valid_sale] = TRUE (),
			        fact_order_seller[is_review_known] = TRUE (),
			        TREATAS ( CALCULATETABLE ( VALUES ( fact_sales_item[os_key] ), fact_sales_item[is_valid_sale] = TRUE () ), fact_order_seller[os_key] )
			    ),
			    CALCULATE (
			        AVERAGE ( fact_order_seller[review_score] ),
			        fact_order_seller[is_valid_sale] = TRUE (),
			        fact_order_seller[is_review_known] = TRUE ()
			    )
			)
		formatString: 0.000
		displayFolder: Giao hàng và review
		lineageTag: 237bfe82-e99b-550a-87ac-673cf8a585cc

	/// delivered_orders: Số đơn có ngày khách nhận trong lát cắt (dim_date đóng vai ngày nhận).
	measure 'Đơn đã giao' =
			CALCULATE (
			    DISTINCTCOUNT ( fact_order_seller[order_id] ),
			    NOT ISBLANK ( fact_order_seller[delivered_ts] ),
			    USERELATIONSHIP ( fact_order_seller[delivered_date_key], dim_date[date_key] )
			)
		formatString: #,0
		displayFolder: Giao hàng và review
		lineageTag: 8f0e7bf3-2e26-576b-8bf1-fee93101df99

	/// customer_late_rate: Số đơn khách nhận trễ / số đơn đã giao.
	measure 'Trễ hẹn với khách' =
			VAR tre = CALCULATE (
			    DISTINCTCOUNT ( fact_order_seller[order_id] ),
			    NOT ISBLANK ( fact_order_seller[delivered_ts] ),
			    fact_order_seller[customer_late] = TRUE (),
			    USERELATIONSHIP ( fact_order_seller[delivered_date_key], dim_date[date_key] )
			)
			RETURN
			    DIVIDE ( tre, [Đơn đã giao] )
		formatString: 0.00%
		displayFolder: Giao hàng và review
		lineageTag: 2f91dbe4-dc8b-5dc1-b7f9-dc0ed8ed2249

	/// seller_late_rate: Số đơn có seller bàn giao vận chuyển sau hạn / số đơn đã giao.
	measure 'Seller giao vận chuyển trễ' =
			VAR tre = CALCULATE (
			    DISTINCTCOUNT ( fact_order_seller[order_id] ),
			    NOT ISBLANK ( fact_order_seller[delivered_ts] ),
			    fact_order_seller[seller_late] = TRUE (),
			    USERELATIONSHIP ( fact_order_seller[delivered_date_key], dim_date[date_key] )
			)
			RETURN
			    DIVIDE ( tre, [Đơn đã giao] )
		formatString: 0.00%
		displayFolder: Giao hàng và review
		lineageTag: 273f45e0-1d8d-561c-b0a7-adf9cdb9923a

	/// late_seller_ok: Trong các đơn khách nhận trễ, tỷ lệ mọi seller đều bàn giao đúng hạn.
	measure 'Đơn trễ, seller đúng hạn' =
			VAR khachTre = CALCULATE (
			    DISTINCTCOUNT ( fact_order_seller[order_id] ),
			    NOT ISBLANK ( fact_order_seller[delivered_ts] ),
			    fact_order_seller[customer_late] = TRUE (),
			    USERELATIONSHIP ( fact_order_seller[delivered_date_key], dim_date[date_key] )
			)
			VAR coSellerTre = CALCULATE (
			    DISTINCTCOUNT ( fact_order_seller[order_id] ),
			    NOT ISBLANK ( fact_order_seller[delivered_ts] ),
			    fact_order_seller[customer_late] = TRUE (),
			    fact_order_seller[seller_late] = TRUE (),
			    USERELATIONSHIP ( fact_order_seller[delivered_date_key], dim_date[date_key] )
			)
			RETURN
			    DIVIDE ( khachTre - coSellerTre, khachTre )
		formatString: 0.00%
		displayFolder: Giao hàng và review
		lineageTag: 45fe3414-b09b-59b5-933d-277672665cd7

