/// Kế hoạch Trưởng nhóm Seller Success đã chốt trên app (src/app/decisions.py). Mỗi mốc as-of một bản; chốt lại thì thay.
table ke_hoach_da_chot
	lineageTag: 9233d9b6-c88a-41f6-9b9a-1b8bb8c2ad0d

	/// Kế hoạch đang hiện là bản Trưởng nhóm đã chốt trên app hay đề xuất mặc định của MILP.
	measure 'Nguồn kế hoạch' =
			VAR asOf = CALCULATE ( MAX ( dss_recommendation[as_of_key] ), REMOVEFILTERS ( dim_seller ), REMOVEFILTERS ( dim_region ) )
			VAR daChot = NOT ISEMPTY ( CALCULATETABLE ( ke_hoach_da_chot, ke_hoach_da_chot[as_of_key] = asOf, REMOVEFILTERS ( dim_seller ), REMOVEFILTERS ( dim_region ) ) )
			RETURN
			    IF (
			        daChot,
			        "Đã chốt trên app " & FORMAT ( CALCULATE ( MAX ( ke_hoach_da_chot[chot_luc] ), ke_hoach_da_chot[as_of_key] = asOf, REMOVEFILTERS ( dim_seller ), REMOVEFILTERS ( dim_region ) ), "HH:mm dd/MM" ),
			        "Đề xuất mặc định (chưa chốt)"
			    )
		displayFolder: Kế hoạch áp dụng
		lineageTag: 05e093d2-7043-4bcf-bd07-fb44f07b9634

	/// GMV rủi ro của seller được gọi hoặc hỗ trợ trong kế hoạch đã chốt; chưa chốt thì theo đề xuất mặc định.
	measure 'GMV rủi ro trong kế hoạch (áp dụng)' =
			VAR asOf = CALCULATE ( MAX ( dss_recommendation[as_of_key] ), REMOVEFILTERS ( dim_seller ), REMOVEFILTERS ( dim_region ) )
			VAR daChot = NOT ISEMPTY ( CALCULATETABLE ( ke_hoach_da_chot, ke_hoach_da_chot[as_of_key] = asOf, REMOVEFILTERS ( dim_seller ), REMOVEFILTERS ( dim_region ) ) )
			RETURN
			    IF ( daChot, CALCULATE ( SUM ( ke_hoach_da_chot[gmv_risk] ), ke_hoach_da_chot[as_of_key] = asOf, ke_hoach_da_chot[action] IN { "CALL", "OPS" } ), [GMV rủi ro trong kế hoạch] )
		formatString: #,0
		displayFolder: Kế hoạch áp dụng
		lineageTag: a6f5f35e-99f7-4ba8-81c6-4413424ebf05

	measure 'Seller gọi (áp dụng)' =
			VAR asOf = CALCULATE ( MAX ( dss_recommendation[as_of_key] ), REMOVEFILTERS ( dim_seller ), REMOVEFILTERS ( dim_region ) )
			VAR daChot = NOT ISEMPTY ( CALCULATETABLE ( ke_hoach_da_chot, ke_hoach_da_chot[as_of_key] = asOf, REMOVEFILTERS ( dim_seller ), REMOVEFILTERS ( dim_region ) ) )
			RETURN
			    IF ( daChot, CALCULATE ( COUNTROWS ( ke_hoach_da_chot ), ke_hoach_da_chot[as_of_key] = asOf, ke_hoach_da_chot[action] = "CALL" ) + 0, [Seller được đề xuất gọi] )
		formatString: #,0
		displayFolder: Kế hoạch áp dụng
		lineageTag: 82be80d2-8341-4657-b509-11e25b09801e

	measure 'Seller hỗ trợ (áp dụng)' =
			VAR asOf = CALCULATE ( MAX ( dss_recommendation[as_of_key] ), REMOVEFILTERS ( dim_seller ), REMOVEFILTERS ( dim_region ) )
			VAR daChot = NOT ISEMPTY ( CALCULATETABLE ( ke_hoach_da_chot, ke_hoach_da_chot[as_of_key] = asOf, REMOVEFILTERS ( dim_seller ), REMOVEFILTERS ( dim_region ) ) )
			RETURN
			    IF ( daChot, CALCULATE ( COUNTROWS ( ke_hoach_da_chot ), ke_hoach_da_chot[as_of_key] = asOf, ke_hoach_da_chot[action] = "OPS" ) + 0, [Seller được đề xuất hỗ trợ] )
		formatString: #,0
		displayFolder: Kế hoạch áp dụng
		lineageTag: c16eb785-f81c-41e4-a1bf-88cc4ce3b270

	/// Số seller được gọi hoặc hỗ trợ.
	measure 'Seller trong kế hoạch (áp dụng)' =
			[Seller gọi (áp dụng)] + [Seller hỗ trợ (áp dụng)]
		formatString: #,0
		displayFolder: Kế hoạch áp dụng
		lineageTag: ea9ff39e-9c1a-488f-8a4e-2fd91e91af6b

	measure 'Tiền đã dùng (áp dụng)' =
			VAR asOf = CALCULATE ( MAX ( dss_recommendation[as_of_key] ), REMOVEFILTERS ( dim_seller ), REMOVEFILTERS ( dim_region ) )
			VAR daChot = NOT ISEMPTY ( CALCULATETABLE ( ke_hoach_da_chot, ke_hoach_da_chot[as_of_key] = asOf, REMOVEFILTERS ( dim_seller ), REMOVEFILTERS ( dim_region ) ) )
			RETURN
			    IF ( daChot, CALCULATE ( SUM ( ke_hoach_da_chot[cost] ), ke_hoach_da_chot[as_of_key] = asOf ), [Tiền đã dùng] )
		formatString: #,0
		displayFolder: Kế hoạch áp dụng
		lineageTag: 103dca43-9225-4efb-8881-55463bc0b588

	measure '% GMV rủi ro được xử lý (áp dụng)' =
			DIVIDE ( [GMV rủi ro trong kế hoạch (áp dụng)], [GMV rủi ro 45 ngày] )
		formatString: 0%
		displayFolder: Kế hoạch áp dụng
		lineageTag: 68474c94-0ef6-440b-9e72-769fab3b8c89

	measure 'Hành động (áp dụng)' =
			VAR asOf = CALCULATE ( MAX ( dss_recommendation[as_of_key] ), REMOVEFILTERS ( dim_seller ), REMOVEFILTERS ( dim_region ) )
			VAR daChot = NOT ISEMPTY ( CALCULATETABLE ( ke_hoach_da_chot, ke_hoach_da_chot[as_of_key] = asOf, REMOVEFILTERS ( dim_seller ), REMOVEFILTERS ( dim_region ) ) )
			VAR a = CALCULATE ( SELECTEDVALUE ( ke_hoach_da_chot[action] ), ke_hoach_da_chot[as_of_key] = asOf )
			RETURN
			    IF ( daChot, SWITCH ( a, "CALL", "Gọi ngay", "OPS", "Hỗ trợ vận hành" ), [Hành động trong kế hoạch] )
		displayFolder: Kế hoạch áp dụng
		lineageTag: f77f04b6-ea6d-4a51-a71a-282a1c7a8a5d

	measure 'Khả năng sụt (áp dụng)' =
			VAR asOf = CALCULATE ( MAX ( dss_recommendation[as_of_key] ), REMOVEFILTERS ( dim_seller ), REMOVEFILTERS ( dim_region ) )
			VAR daChot = NOT ISEMPTY ( CALCULATETABLE ( ke_hoach_da_chot, ke_hoach_da_chot[as_of_key] = asOf, REMOVEFILTERS ( dim_seller ), REMOVEFILTERS ( dim_region ) ) )
			RETURN
			    IF ( daChot, CALCULATE ( MAX ( ke_hoach_da_chot[p_decline] ), ke_hoach_da_chot[as_of_key] = asOf, ke_hoach_da_chot[action] IN { "CALL", "OPS" } ), [Khả năng sụt (kế hoạch)] )
		formatString: 0%
		displayFolder: Kế hoạch áp dụng
		lineageTag: 825f3a6f-d41e-4b10-bb01-d74335948ac5

	column as_of
