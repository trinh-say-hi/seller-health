model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["ThuMucParquet", "dim_date", "dim_region", "dim_seller", "dim_product", "dim_location", "dim_route", "dim_seller_health", "fact_sales_item", "fact_order_seller", "fact_seller_monthly", "kpi_monthly", "dss_recommendation"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table dim_date
ref table dim_region
ref table dim_seller
ref table dim_product
ref table dim_location
ref table dim_route
ref table dim_seller_health
ref table fact_sales_item
ref table fact_order_seller
ref table fact_seller_monthly
ref table kpi_monthly
ref table dss_recommendation
ref table 'Hiệu quả can thiệp'

ref role 'Quản lý vùng Sudeste'

