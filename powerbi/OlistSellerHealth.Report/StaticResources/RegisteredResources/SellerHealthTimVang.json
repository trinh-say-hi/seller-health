{
  "name": "Seller Health - Tím Vàng",
  "dataColors": ["#5B2A86", "#E8A400", "#9D6BD6", "#F5CC4E", "#2E1446", "#B07D00", "#C9B2EC", "#7C5A9E"],
  "background": "#FFFFFF",
  "foreground": "#2E1446",
  "tableAccent": "#E8A400",
  "good": "#2E9E6A",
  "neutral": "#E8A400",
  "bad": "#C2185B",
  "maximum": "#5B2A86",
  "center": "#F5CC4E",
  "minimum": "#FFF6DB",
  "textClasses": {
    "callout": {"fontSize": 24, "fontFace": "Segoe UI Semibold", "color": "#3D1A5B"},
    "title": {"fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#3D1A5B"},
    "header": {"fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#3D1A5B"},
    "label": {"fontSize": 9, "fontFace": "Segoe UI", "color": "#5E4B73"}
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{"show": true, "color": {"solid": {"color": "#FFFFFF"}}, "transparency": 0}],
        "border": [{"show": true, "color": {"solid": {"color": "#E4D9F2"}}, "radius": 10}],
        "dropShadow": [{"show": false}],
        "padding": [{"top": 8, "bottom": 8, "left": 10, "right": 10}],
        "title": [{"fontColor": {"solid": {"color": "#3D1A5B"}}, "fontSize": 11, "bold": true}],
        "visualHeader": [{"background": {"solid": {"color": "#FFFFFF"}}, "foreground": {"solid": {"color": "#5B2A86"}}}]
      }
    },
    "page": {
      "*": {
        "background": [{"color": {"solid": {"color": "#F4EFFA"}}, "transparency": 0}],
        "outspace": [{"color": {"solid": {"color": "#E9E1F4"}}}]
      }
    },
    "card": {
      "*": {
        "labels": [{"color": {"solid": {"color": "#3D1A5B"}}, "fontSize": 24}],
        "categoryLabels": [{"color": {"solid": {"color": "#8A6FA8"}}, "fontSize": 10}],
        "border": [{"show": true, "color": {"solid": {"color": "#E8A400"}}, "radius": 10}]
      }
    },
    "slicer": {
      "*": {
        "header": [{"fontColor": {"solid": {"color": "#5B2A86"}}, "textSize": 9}],
        "items": [{"fontColor": {"solid": {"color": "#2E1446"}}, "textSize": 10}]
      }
    },
    "textbox": {
      "*": {
        "background": [{"show": false}],
        "border": [{"show": false}]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [{"fontColor": {"solid": {"color": "#FFFFFF"}}, "backColor": {"solid": {"color": "#5B2A86"}}}],
        "rowHeaders": [{"fontColor": {"solid": {"color": "#2E1446"}}}],
        "total": [{"fontColor": {"solid": {"color": "#2E1446"}}, "backColor": {"solid": {"color": "#FFF1C7"}}}]
      }
    }
  }
}
